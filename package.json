{
  "name": "bgs-work-space",
  "version": "1.0.1",
  "private": true,
  "description": "BGS Work Space - Production Team & Work Management System",
  "main": "Backend/src/server.js",
  "scripts": {
    "start": "node Backend/src/server.js",
    "build": "node -e \"if(require('fs').existsSync('Frontend'))process.chdir('Frontend');require('child_process').execSync('npm install && npm run build',{stdio:'inherit'});if(!require('fs').existsSync('vite.config.ts')){const fs=require('fs');try{fs.cpSync('Frontend/dist','dist',{recursive:true});}catch(e){}}\"",
    "deploy": "node -e \"if(require('fs').existsSync('Frontend'))process.chdir('Frontend');require('child_process').execSync('npx wrangler deploy',{stdio:'inherit'})\"",
    "backend:start": "cd Backend && npm start",
    "backend:dev": "cd Backend && npm run dev",
    "frontend:dev": "cd Frontend && npm run dev",
    "frontend:build": "cd Frontend && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

